# Backend ortam degiskenleri (ornek)
# Bu dosyayi .env olarak kopyalayip degerleri doldurun.

# Sunucu portu (varsayilan 3001)
PORT=3001

# Production'da mutlaka doldurun. Virgulle ayrilmis izinli origin listesi.
# Bos birakilirsa tum origin'lere izin verilir — yalnizca yerel gelistirme icin uygundur.
ALLOWED_ORIGINS=https://kuranrehberi.com,https://www.kuranrehberi.com

# production degerinde ic hata detaylari istemciye gonderilmez
NODE_ENV=production
